# MinerU 4.x image, built locally — mirrors opendatalab/MinerU docker/china/Dockerfile
# (https://github.com/opendatalab/MinerU/blob/master/docker/china/Dockerfile).
#
# MinerU publishes no prebuilt image, so `compose.mineru.yaml` builds this one.
# The MinerU repo checkout is NOT needed: the official build only consumes the
# vLLM base image and `pip install mineru[torch]`; the Dockerfile itself is the
# only thing from the repo.
#
# Build: docker compose -f docker/compose.mineru.yaml up -d --build
#
# GPU support: Volta → Blackwell (compute capability 7.0–12.1). The default base
# is vLLM 0.21.0 on CUDA 13.0, pulled straight from Docker Hub — measured ~19 MB/s
# here vs ~1–2 MB/s through the DaoCloud mirror, so prefer the direct name. If
# Docker Hub is unreachable, build with
#   --build-arg VLLM_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.21.0
# For a CUDA 12.9 host, append -cu129 to the tag.

ARG VLLM_IMAGE=vllm/vllm-openai:v0.21.0
FROM ${VLLM_IMAGE}

# libgl is needed by opencv (MinerU's layout/OCR pipeline)
RUN apt-get update && \
    apt-get install -y libgl1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install MinerU 4.x against the vLLM already present in the base image.
# (--break-system-packages: the vLLM base image carries a distro-managed Python)
ARG MINERU_PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
RUN python3 -m pip install -U 'mineru[torch]>=4.0,<5' -i ${MINERU_PIP_INDEX} --break-system-packages && \
    python3 -m pip cache purge

# Keep build-time model downloads and runtime selection aligned, including
# builds without a GPU.
ENV MINERU_MODEL_SMALL_BACKEND=torch \
    MINERU_MODEL_VLM_ENGINE=vllm

# Bake the Torch bundle and original VLM weights into the image (~10GB+), so the
# container never downloads models at startup.
ARG MINERU_MODEL_SOURCE_ARG=modelscope
RUN mineru-kit models download --tier standard --small-backend torch --vlm-engine vllm -s ${MINERU_MODEL_SOURCE_ARG}

# Runtime reads weights from the image, never from the network.
ENTRYPOINT ["/bin/bash", "-c", "export MINERU_MODEL_SOURCE=local && exec \"$@\"", "--"]
